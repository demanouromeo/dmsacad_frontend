<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files/directories (assets, index.html itself, etc.) resolve normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side React Router route - serve index.html and
  # let the app's own routing (and RequireAuth's redirect-to-login) take over.
  RewriteRule ^ index.html [L]
</IfModule>
